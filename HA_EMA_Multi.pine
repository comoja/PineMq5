//@version=6
strategy("HA_EMA Multi (Gold & Silver)", overlay=true, initial_capital=450,
forex_account = input.string("", "Cuenta FOREX.com", group="Configuración de Cuenta")
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0.04)

//+------------------------------------------------------------------+
//|                                             HA_EMA_Multi.pine    |
//|               Estrategia Unificada Heikin-Ashi + EMA             |
//|                    para ORO (XAU) y PLATA (XAG)                  |
//|          Con Autodetección de Activo, MTF y Break-Even           |
//+------------------------------------------------------------------+

// ════════════════════════════════════════════════════════════════════
// 1. INPUTS DE PERFIL Y AUTODETECCIÓN
// ════════════════════════════════════════════════════════════════════
gpProf       = "--- PERFIL DE CONFIGURACIÓN ---"
assetProfile = input.string("Auto", "Perfil de Activo", options=["Auto", "Oro (XAUUSD)", "Plata (XAGUSD)", "Bitcoin (BTCUSD)", "Nasdaq (NAS100)", "Manual"], group=gpProf,
                 tooltip="Auto: detecta el símbolo actual para aplicar los parámetros óptimos de Oro, Plata, Bitcoin o Nasdaq. Manual: usa los parámetros de abajo.")

// ════════════════════════════════════════════════════════════════════
// 2. INPUTS DE GESTIÓN DE RIESGO
// ════════════════════════════════════════════════════════════════════
gpRisk       = "--- GESTIÓN DE RIESGO ---"
riskPerc     = input.float(1.0, "Riesgo por operación (%)", minval=0.1, maxval=10.0, group=gpRisk,
                 tooltip="Porcentaje de la equidad a arriesgar basado en la distancia del SL inicial")
useTP        = input.bool(true, "Usar Take Profit Fijo", group=gpRisk)
rrRatioIn   = input.float(3.0, "Relación Riesgo/Recompensa (R:R)", minval=0.5, step=0.1, group=gpRisk,
                 tooltip="Oro sugerido: 3.0. Plata sugerido: 2.5.")
// useBEIn     = input.bool(true, "Mover a Break-Even (Precio Entrada)", group=gpRisk,
//                  tooltip="ACTIVADO: protege el capital moviendo el SL a precio de entrada cuando el precio avanza a tu favor.")
// beRatioIn   = input.float(1.0, "Multiplicador R:R para Break-Even", minval=0.3, step=0.1, group=gpRisk,
//                  tooltip="1.0 = mueve a Break-Even al alcanzar beneficio 1:1 R:R (seguridad absoluta).")
useTPChaseIn = input.bool(false, "Usar Persecución de TP (TP Chasing)", group=gpRisk,
                 tooltip="ACTIVADO: el TP se aleja del precio si este se acerca a la distancia especificada.")
 
chase = 3.0
tpChasePtsIn = input.float(chase, "Distancia de Persecución TP (Pts)", minval=0.1, step=1.0, group=gpRisk,
                 tooltip="Distancia en puntos/ticks desde el precio hasta el TP para activar la persecución.")
tpChaseOffsetIn = input.float(chase, "Avance del TP (Pts)", minval=0.1, step=1.0, group=gpRisk,
                 tooltip="Distancia en puntos/ticks que se colocará el TP por delante del precio actual.")
trailDivisionsIn = input.int(7, "Divisiones del Trailing (partes del recorrido TP→SL)", minval=1, maxval=20, group=gpRisk,
                 tooltip="Número de partes en que se divide el recorrido SL→TP para avanzar el SL dinámico. Por defecto 7.")

useFixedLotIn    = input.bool(false, "¿Usar Lote Fijo? (True=Fijo, False=Riesgo %)", group=gpRisk)
fixedLotValIn    = input.float(0.01, "Valor de Lote Fijo (Lotes MT5, ej: 0.01)", group=gpRisk)
maxRiskPercIn    = input.float(5.0, "Riesgo Máximo Permitido por Trade (% Balance)", minval=0.1, maxval=100.0, group=gpRisk)
maxSpreadPointsIn = input.float(50.0, "Spread Máximo Permitido (Puntos)", minval=0.1, group=gpRisk)
minStopsLevelIn  = input.float(0.0, "Mínimo Stop Level (Puntos)", minval=0.0, group=gpRisk)

// ════════════════════════════════════════════════════════════════════
// 3. INPUTS MANUALES (Solo si Perfil = Manual)
// ════════════════════════════════════════════════════════════════════
gpParam        = "--- PARÁMETROS MANUALES (Si perfil = Manual) ---"
emaTFInput    = input.string("Auto", "Temporalidad de EMAs", options=["Auto", "15", "30", "60", "180", "240", "1440"], group=gpParam,
                   tooltip="Auto: fuerza EMAs a 3h en intradía para filtrar ruido.")
emaFastLenIn = input.int(21,  "Período EMA Rápida manual", minval=1, group=gpParam)
emaSlowLenIn = input.int(55,  "Período EMA Lenta manual", minval=1, group=gpParam)
swingPeriodIn = input.int(8,   "Velas Swing High/Low manual", minval=2, group=gpParam)
slBufPtsIn   = input.float(2.0, "Buffer SL manual (Ticks/Puntos)", minval=0.0, group=gpParam)

useIMACDIn    = input.bool(false, "Usar iMACD manual", group=gpParam)
imacdLenIn    = input.int(35,     "Período iMACD manual", minval=1, group=gpParam)

useEMASprIn  = input.bool(true,  "Usar Abertura EMAs manual", group=gpParam)
emaSprMultIn = input.float(0.4,  "Abertura Mínima EMAs manual (× ATR)", minval=0.0, step=0.1, group=gpParam)

useHAStrIn   = input.bool(false, "Fuerza Heikin-Ashi manual", group=gpParam)
useEmaTendenciaIn  = input.bool(false, "Filtro EMA Tendencia manual", group=gpParam)
emaTendenciaLenIn  = input.int(100,    "Período EMA Tendencia manual", minval=1, group=gpParam)
convergenciaMultIn = input.float(0.25, "Multiplicador de Convergencia manual (× ATR)", minval=0.01, step=0.01, group=gpParam,
                        tooltip="Rango máximo de dispersión entre las 3 EMAs para considerarse convergentes. Por defecto 0.25.")

// Filtros específicos adicionales manuales
useATRMinIn   = input.bool(false, "Filtro ATR Mínimo manual", group=gpParam)
atrFilterLenIn = input.int(14,    "Período ATR manual", minval=1, group=gpParam)
atrMinUSDIn   = input.float(2.0,  "ATR Mínimo USD manual", minval=0.1, step=0.1, group=gpParam)
useADXIn       = input.bool(false, "Filtro ADX manual", group=gpParam)
adxLenIn       = input.int(14,     "Período ADX manual", minval=1, group=gpParam)
adxMinIn       = input.float(22.0, "ADX Mínimo manual", minval=5.0, step=1.0, group=gpParam)
useRSIIn       = input.bool(false, "Filtro RSI manual", group=gpParam)
rsiLenIn       = input.int(14,     "Período RSI manual", minval=1, group=gpParam)
rsiOBIn        = input.float(70.0, "RSI Sobrecompra manual", minval=50.0, group=gpParam)
rsiOSIn        = input.float(30.0, "RSI Sobreventa manual", maxval=50.0, group=gpParam)
useHTFIn       = input.bool(false, "Filtro HTF manual", group=gpParam)
htfEMALenIn   = input.int(50,     "Período EMA HTF manual", minval=1, group=gpParam)

// Filtro Horario General (Londres + Nueva York)
gpSes          = "--- CONTROL DE SESIÓN ---"
useSessionIn   = input.bool(false, "Usar Sesión Horaria", group=gpSes,
                   tooltip="Desactivado por defecto. Activa si solo quieres operar en horas específicas.")
sessionStrIn   = input.session("0800-1700", "Horario Operativo (UTC)", group=gpSes)
timezoneIn     = input.string("America/New_York", "Zona Horaria de la Sesión", options=["America/New_York", "America/Mexico_City", "UTC"], group=gpSes)

// ════════════════════════════════════════════════════════════════════
// 3.5. VARIABLES GLOBALES DE PARÁMETROS E INDICADORES (Reglas del Proyecto)
// ════════════════════════════════════════════════════════════════════
// Parámetros de Indicadores
var int fastLen = 21       // Período de EMA rápida
var int slowLen = 5       // Período de EMA lenta
var int trendLen = 100     // Período de EMA de tendencia
var int swingLen = 8       // Velas para Swing High/Low
var int imacdPeriod = 35   // Período iMACD
var int atrPeriod = 14     // Período ATR
var int adxPeriod = 14     // Período ADX
var int rsiPeriod = 14     // Período RSI
var int htfLen = 50        // Período EMA HTF
var float convergenciaMult = 0.25 // Multiplicador de convergencia para el rango de EMAs
var int barUltimaEntradaLong  = na  // Guarda la barra de la última entrada en compra
var int barUltimaEntradaShort = na  // Guarda la barra de la última entrada en venta

// Gestión de Riesgo y Parámetros Operativos
var float slBufferPts = 2.0
var float rrRatio = 3.0
// var bool useBE = true
// var float beRatio = 1.0
var bool useIMACD = false
var bool useEMASpread = true
var float emaSpreadMult = 0.4
var bool useHAStrength = false
var bool useEmaTendencia = false
var bool useATRMin = false
var float atrMinUSD = 2.0
var bool useADX = false
var float adxMin = 22.0
var bool useRSI = false
var float rsiOB = 70.0
var float rsiOS = 30.0
var bool useHTF = false
var bool useTPChase = false
var float tpChasePts = 3.0
var float tpChaseOffset = 3.0
var bool useSession = false
var string sessionStr = "0800-1700"
var string timezoneVal = "America/New_York"
var bool useFixedLot = false
var float fixedLotValue = 0.01
var float maxRiskPerc = 5.0
var float minStopsLevel = 0.0
var int trailDivisions = 6

// Detección y Variables de Huso Horario (Reglas del Proyecto)
var string targetTimezone = "America/New_York" // Zona horaria de sesión activa
var string nySession = "0800-1700"              // Horario operativo adaptado a NY
var string cdmxSession = "0700-1600"            // Horario operativo adaptado a CDMX

// ════════════════════════════════════════════════════════════════════
// 4. AUTODETECCIÓN Y ASIGNACIÓN DE PARÁMETROS EFECTIVOS
// ════════════════════════════════════════════════════════════════════
tickerLower = str.lower(syminfo.ticker)
isGoldSymbol    = str.contains(tickerLower, "xau") or str.contains(tickerLower, "gold")
isSilverSymbol  = str.contains(tickerLower, "xag") or str.contains(tickerLower, "silver")
isBitcoinSymbol = str.contains(tickerLower, "btc") or str.contains(tickerLower, "bitcoin")
isNasdaqSymbol  = str.contains(tickerLower, "nas100") or str.contains(tickerLower, "nasdaq") or str.contains(tickerLower, "us100") or str.contains(tickerLower, "ustec") or str.contains(tickerLower, "nq") or str.contains(tickerLower, "tech")

isGold    = assetProfile == "Oro (XAUUSD)"     or (assetProfile == "Auto" and isGoldSymbol)
isSilver  = assetProfile == "Plata (XAGUSD)"   or (assetProfile == "Auto" and isSilverSymbol)
isBitcoin = assetProfile == "Bitcoin (BTCUSD)" or (assetProfile == "Auto" and isBitcoinSymbol)
isNasdaq  = assetProfile == "Nasdaq (NAS100)"  or (assetProfile == "Auto" and isNasdaqSymbol)

isManual        = not (isGold or isSilver or isBitcoin or isNasdaq)
emaTF           = isGold ? timeframe.period : isSilver ? "15" : isBitcoin ? "15" : isNasdaq ? timeframe.period : emaTFInput

// Asignaciones por defecto basadas en los inputs
fastLen := emaFastLenIn
slowLen := emaSlowLenIn
trendLen := emaTendenciaLenIn
swingLen := swingPeriodIn
imacdPeriod := imacdLenIn
atrPeriod := atrFilterLenIn
adxPeriod := adxLenIn
rsiPeriod := rsiLenIn
htfLen := htfEMALenIn

slBufferPts := slBufPtsIn
rrRatio := rrRatioIn
// useBE := useBEIn
// beRatio := beRatioIn
useIMACD := useIMACDIn
useEMASpread := useEMASprIn
emaSpreadMult := emaSprMultIn
useHAStrength := useHAStrIn
useEmaTendencia := useEmaTendenciaIn
useATRMin := useATRMinIn
atrMinUSD := atrMinUSDIn
useADX := useADXIn
adxMin := adxMinIn
useRSI := useRSIIn
rsiOB := rsiOBIn
rsiOS := rsiOSIn
useHTF := useHTFIn
useTPChase := useTPChaseIn
tpChasePts := tpChasePtsIn
tpChaseOffset := tpChaseOffsetIn
useSession := useSessionIn
sessionStr := sessionStrIn
timezoneVal := timezoneIn
useFixedLot := useFixedLotIn
fixedLotValue := fixedLotValIn
maxRiskPerc := maxRiskPercIn
minStopsLevel := minStopsLevelIn
trailDivisions := isManual ? trailDivisionsIn : 7
convergenciaMult := isManual ? convergenciaMultIn : 0.25

// Sobreescritura por perfil (encapsulado por instrumento)
if not isManual
    useHTF        := false
    useFixedLot   := false
    fixedLotValue := 0.01
    minStopsLevel := 0.0

if isGold
    fastLen       := 10
    slowLen       := 21
    trendLen      := 16   // Restaurado a 16 según visualización del usuario
    swingLen      := 12
    imacdPeriod   := 35
    atrPeriod     := 14
    adxPeriod     := 14
    rsiPeriod     := 14
    htfLen        := 50
    slBufferPts   := 0.5
    rrRatio       := 2.0
    // useBE         := false
    // beRatio       := 1.8
    useIMACD      := true
    useEMASpread  := true
    emaSpreadMult := 0.15
    useHAStrength := false
    useEmaTendencia := true
    useATRMin     := true
    atrMinUSD     := 1.5  // Corregido de 3.5 a 1.5 para mayor sensibilidad en 15m
    useADX        := true
    adxMin        := 22.0
    useRSI        := false
    useTPChase    := true
    tpChasePts    := 11.7
    tpChaseOffset := 11.7
    useSession    := false
    sessionStr    := "0700-1700"
    timezoneVal   := "UTC"
    maxRiskPerc   := 5.5
else if isSilver
    fastLen       := 9
    slowLen       := 21
    trendLen      := 100
    swingLen      := 5
    imacdPeriod   := 35
    atrPeriod     := 14
    adxPeriod     := 14
    rsiPeriod     := 14
    htfLen        := 50
    slBufferPts   := 0.0
    rrRatio       := 2.5  // Corregido de 0.0 a 2.5
    // useBE         := false
    // beRatio       := 1.0
    useIMACD      := true
    useEMASpread  := false
    emaSpreadMult := 0.0
    useHAStrength := true
    useEmaTendencia := true
    useATRMin     := false
    atrMinUSD     := 1.0
    useADX        := false
    adxMin        := 22.0
    useRSI        := false
    useTPChase    := true
    tpChasePts    := 0.55
    tpChaseOffset := 0.55
    useSession    := false
else if isBitcoin
    fastLen       := 9
    slowLen       := 21
    trendLen      := 100
    swingLen      := 5
    imacdPeriod   := 35
    atrPeriod     := 14
    adxPeriod     := 14
    rsiPeriod     := 14
    htfLen        := 50
    slBufferPts   := 0.0
    rrRatio       := 1.8
    // useBE         := true
    // beRatio       := 1.0
    useIMACD      := true
    useEMASpread  := true
    emaSpreadMult := 0.3
    useHAStrength := true
    useEmaTendencia := true
    useATRMin     := false
    atrMinUSD     := 2.0
    useADX        := false
    adxMin        := 22.0
    useRSI        := true
    rsiOB         := 70.0
    rsiOS         := 0.0
    useTPChase    := true
    tpChasePts    := 150.0
    tpChaseOffset := 150.0
    useSession    := false
else if isNasdaq
    fastLen       := 9
    slowLen       := 21
    trendLen      := 100
    swingLen      := 5
    imacdPeriod   := 35
    atrPeriod     := 14
    adxPeriod     := 14
    rsiPeriod     := 14
    htfLen        := 50
    slBufferPts   := 0.0
    rrRatio       := 1.5
    // useBE         := true
    // beRatio       := 1.0
    useIMACD      := false
    useEMASpread  := false
    emaSpreadMult := 0.0
    useHAStrength := false
    useEmaTendencia := false
    useATRMin     := false
    atrMinUSD     := 2.0
    useADX        := false
    adxMin        := 22.0
    useRSI        := false
    rsiOB         := 75.0
    rsiOS         := 25.0
    useTPChase    := true
    tpChasePts    := 15.0
    tpChaseOffset := 15.0
    useSession    := false

// Configuración de Zonas Horarias NY y CDMX
targetTimezone := timezoneVal
if targetTimezone == "America/New_York"
    nySession := "0800-1700"
    cdmxSession := "0700-1600"
else if targetTimezone == "America/Mexico_City"
    nySession := "0900-1800"
    cdmxSession := "0800-1700"
else // UTC
    nySession := "1300-2200"
    cdmxSession := "1200-2100"

// --- VALIDACIÓN DE TEMPORALIDAD CORRECTA EN TRADINGVIEW ---
correctTF = isGold ? "15" : isSilver ? "30" : isBitcoin ? "30" : isNasdaq ? "5" : ""
if correctTF != "" and timeframe.period != correctTF
    runtime.error("Temporalidad incorrecta para " + (isGold ? "Oro (XAUUSD)" : isSilver ? "Plata (XAGUSD)" : isBitcoin ? "Bitcoin (BTCUSD)" : "Nasdaq (NAS100)") + ". Por favor, cambie el timeframe del gráfico a " + (isGold ? "15 minutos (15m)" : isSilver or isBitcoin ? "30 minutos (30m)" : "5 minutos (5m)") + " para el correcto funcionamiento de la estrategia.")

// ════════════════════════════════════════════════════════════════════
// 5. CÁLCULO DE VELAS HEIKIN-ASHI RECURSIVAS NATIVAS
// ════════════════════════════════════════════════════════════════════
var float haOpen = na
haClose = (open + high + low + close) / 4
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

haGreen = haClose > haOpen
haRed   = haClose < haOpen

// Pintar velas HA semi-transparentes de fondo
plotcandle(haOpen, haHigh, haLow, haClose, title="Velas Heikin-Ashi",
           color=haGreen ? color.new(color.green, 85) : color.new(color.red, 85),
           wickcolor=haGreen ? color.new(color.green, 80) : color.new(color.red, 80),
           bordercolor=na)

// ════════════════════════════════════════════════════════════════════
// 6. RESOLUCIÓN DE TEMPORALIDADES MTF Y MEDIAS MÓVILES
// ════════════════════════════════════════════════════════════════════
string resolvedTF = emaTF
if emaTF == "Auto"
    resolvedTF := timeframe.period // Usa el gráfico actual (ej. 15min), igual que el .mq5

// EMAs: directas si mismo TF; request.security si TF difiere (Silver/Bitcoin 15min en gráfico 30min)
needsMTF     = resolvedTF != timeframe.period
emaFast      = needsMTF ? request.security(syminfo.tickerid, resolvedTF, ta.ema(close, fastLen),      lookahead=barmerge.lookahead_off) : ta.ema(close, fastLen)
emaSlow      = needsMTF ? request.security(syminfo.tickerid, resolvedTF, ta.ema(close, slowLen),      lookahead=barmerge.lookahead_off) : ta.ema(close, slowLen)
emaTendencia = needsMTF ? request.security(syminfo.tickerid, resolvedTF, ta.ema(close, trendLen),     lookahead=barmerge.lookahead_off) : ta.ema(close, trendLen)

plot(emaFast, "EMA Rápida", color=color.new(color.lime, 10), linewidth=2)
plot(emaSlow, "EMA Lenta",  color=color.new(color.red,  10), linewidth=2)
plot(useEmaTendencia ? emaTendencia : na, "EMA Tendencia", color=color.new(color.blue, 30), linewidth=1, linestyle=plot.linestyle_dashed)

// ════════════════════════════════════════════════════════════════════
// 7. CÁLCULO DE INDICADORES DE FILTRO
// ════════════════════════════════════════════════════════════════════

// --- FILTRO DE CONTROL HORARIO ---
inSession = not useSession or not na(time(timeframe.period, sessionStr, timezoneVal))

// --- FILTRO DE ABERTURA DE EMAs ---
atrVal        = ta.atr(atrPeriod)   // calculado aquí: compartido por aberturaOK y atrOK
distanciaEMAs = math.abs(emaFast - emaSlow)
aberturaOK    = not useEMASpread or (distanciaEMAs >= (atrVal * emaSpreadMult))

// --- FILTRO IMPULSE MACD ---
calcZLEMA(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    d = ema1 - ema2
    ema1 + d

imacdSrc = hlc3
hi = ta.highest(high, imacdPeriod)
lo = ta.lowest(low, imacdPeriod)
mi = calcZLEMA(imacdSrc, imacdPeriod)
md = mi > hi ? mi - hi : mi < lo ? mi - lo : 0.0

imacdLongOK  = not useIMACD or (md >= 0.0)   // md==0.0 en zona neutra al salir del rango: permitido
imacdShortOK = not useIMACD or (md <= 0.0)   // md==0.0 en zona neutra al salir del rango: permitido

// Filtro de posición: la EMA rápida debe estar por encima de la EMA de tendencia para Longs, y por debajo para Shorts (evita bloqueos si la tendencia es menor a la lenta)
emaTendenciaLongOK  = not useEmaTendencia or (emaFast > emaTendencia)
emaTendenciaShortOK = not useEmaTendencia or (emaFast < emaTendencia)

// Filtro de dirección de pendiente de la EMA de tendencia (azul)
pendienteLong  = emaTendencia > emaTendencia[1]
pendienteShort = emaTendencia < emaTendencia[1]

haStrengthLong  = not useHAStrength or (haLow  == haOpen)
haStrengthShort = not useHAStrength or (haHigh == haOpen)

// Exigir que el giro de color Heikin-Ashi sea reciente (máximo 6 velas)
haColorChangeLong  = ta.barssince(haClose[1] < haOpen[1] and haClose > haOpen) <= 6
haColorChangeShort = ta.barssince(haClose[1] > haOpen[1] and haClose < haOpen) <= 6

// Filtros de volatilidad y fuerza de vela
atrOK      = not useATRMin or (atrVal >= atrMinUSD)
strongBull = (close > open) and (math.abs(close - open) >= atrVal * 0.10)
strongBear = (close < open) and (math.abs(close - open) >= atrVal * 0.10)

[adxVal, diPlus, diMinus] = ta.dmi(adxPeriod, adxPeriod)
adxOK = not useADX or (adxVal >= adxMin)

rsiVal      = ta.rsi(close, rsiPeriod)
rsiLongOK  = not useRSI or (rsiVal < rsiOB)
rsiShortOK = not useRSI or (rsiVal > rsiOS)

htfEMA      = request.security(syminfo.tickerid, "60", ta.ema(close, htfLen), lookahead=barmerge.lookahead_off)
htfLongOK  = not useHTF or (close > htfEMA)
htfShortOK = not useHTF or (close < htfEMA)

// ════════════════════════════════════════════════════════════════════
// 8. CONDICIONES DE ALINEACIÓN, CONVERGENCIA Y GATILLOS
// ════════════════════════════════════════════════════════════════════
// Lógica de convergencia de EMAs (compresión de medias móviles 10, 16, 21)
rangoEMAs = math.max(emaFast, math.max(emaSlow, emaTendencia)) - math.min(emaFast, math.min(emaSlow, emaTendencia))
convergen = rangoEMAs <= (atrVal * convergenciaMult)

// Lógica de ventana de cruce de EMAs reciente (máximo 6 velas atrás)
cruceLong  = ta.crossover(emaFast, emaSlow)
cruceShort = ta.crossunder(emaFast, emaSlow)

cruceRecienteLong  = ta.barssince(cruceLong) <= 6
cruceRecienteShort = ta.barssince(cruceShort) <= 6

barraUltimoCruceLong  = ta.valuewhen(cruceLong, bar_index, 0)
barraUltimoCruceShort = ta.valuewhen(cruceShort, bar_index, 0)

// La señal es elegible si no hemos entrado en este mismo cruce
cruceElegibleLong  = cruceRecienteLong and (na(barUltimaEntradaLong) or barUltimaEntradaLong < barraUltimoCruceLong)
cruceElegibleShort = cruceRecienteShort and (na(barUltimaEntradaShort) or barUltimaEntradaShort < barraUltimoCruceShort)

// Se consideran convergentes si estuvieron en compresión en las últimas 6 barras (ventana de persistencia)
estabanConvergentes = ta.barssince(convergen) <= 6
barraUltimaConvergencia = ta.valuewhen(convergen, bar_index, 0)

// La ruptura es elegible si no hemos entrado en esta misma convergencia
rupturaElegibleLong  = estabanConvergentes[1] and (na(barUltimaEntradaLong) or barUltimaEntradaLong < barraUltimaConvergencia)
rupturaElegibleShort = estabanConvergentes[1] and (na(barUltimaEntradaShort) or barUltimaEntradaShort < barraUltimaConvergencia)

// Ruptura de convergencia: la siguiente vela define dirección, alineada con el sesgo del último cruce físico
ultimoCruceEsLong  = barraUltimoCruceLong >= barraUltimoCruceShort
ultimoCruceEsShort = barraUltimoCruceShort >= barraUltimoCruceLong

rupturaLong  = rupturaElegibleLong and ultimoCruceEsLong and haGreen and strongBull and imacdLongOK and inSession and atrOK and rsiLongOK
rupturaShort = rupturaElegibleShort and ultimoCruceEsShort and haRed and strongBear and imacdShortOK and inSession and atrOK and rsiShortOK

isLongAligned  = cruceElegibleLong and haGreen and strongBull and
                   imacdLongOK  and emaTendenciaLongOK  and haStrengthLong  and
                   haColorChangeLong and pendienteLong and
                   inSession     and aberturaOK     and atrOK            and
                   adxOK         and rsiLongOK      and htfLongOK

isShortAligned = cruceElegibleShort and haRed and strongBear and
                   imacdShortOK and emaTendenciaShortOK and haStrengthShort and
                   haColorChangeShort and pendienteShort and
                   inSession     and aberturaOK     and atrOK            and
                   adxOK         and rsiShortOK     and htfShortOK

// Entrada en alineación de cruce elegible o en la ruptura de la convergencia (siguiente vela)
triggerLong  = isLongAligned or rupturaLong
triggerShort = isShortAligned or rupturaShort

// ════════════════════════════════════════════════════════════════════
// 9. GESTIÓN DEL RIESGO Y DETERMINACIÓN DEL NIVELES DE SL/TP
// ════════════════════════════════════════════════════════════════════
lowestLow   = ta.lowest(low, swingLen)
highestHigh = ta.highest(high, swingLen)
slBuffer    = slBufferPts * syminfo.mintick

var float pendingSL = na
var float pendingTP = na

if triggerLong
    slVal = lowestLow - slBuffer
    risk = close - slVal
    minSLDist = minStopsLevel * syminfo.mintick
    if risk < minSLDist
        risk := minSLDist
    pendingSL := close - risk
    if (close - pendingSL) <= 0
        pendingSL := close - syminfo.mintick
    pendingTP := useTP ? (close + risk * rrRatio) : na

if triggerShort
    slVal = highestHigh + slBuffer
    risk = slVal - close
    minSLDist = minStopsLevel * syminfo.mintick
    if risk < minSLDist
        risk := minSLDist
    pendingSL := close + risk
    if (pendingSL - close) <= 0
        pendingSL := close + syminfo.mintick
    pendingTP := useTP ? (close - risk * rrRatio) : na

// ════════════════════════════════════════════════════════════════════
// 10. VARIABLES PERSISTENTES Y EJECUCIÓN DE ENTRADAS
// ════════════════════════════════════════════════════════════════════
var float activeSL    = na
var float activeTP    = na
var float trailStep   = na
var float entryP      = na
var bool  beTriggered      = false
var bool  tpChaseTriggered = false  // true cuando el TP Chase se activa por primera vez
var float tpChaseSlGap     = na     // distancia fija SL-precio al activarse tpChase
var float slPart           = na     // Una parte (fracción) de la distancia del SL inicial
var float tpPart           = na     // Una parte (fracción) de la distancia del TP inicial
var bool  pasoLaMitad      = false  // Control de avance del SL a la mitad del TP
var bool  slTrail          = false  // Control de activación de persecución dinámica

// Cálculo de lotaje en base a riesgo inicial o lote fijo
contractSize = isGold ? 100.0 : isSilver ? 5000.0 : isBitcoin ? 1.0 : isNasdaq ? 1.0 : 100.0
riskAmount   = strategy.equity * (riskPerc / 100.0)
riskDist     = math.abs(close - pendingSL)
qty          = 0.0

if useFixedLot
    qty := fixedLotValue * contractSize
else
    qty := riskDist > 0 ? riskAmount / (riskDist * syminfo.pointvalue) : 0.0

// 5. PROTECCIÓN DE SOBRE-EXPOSICIÓN (FILTRO DE RIESGO MÁXIMO)
riskInMoney  = riskDist * qty * syminfo.pointvalue
maxRiskMoney = strategy.equity * (maxRiskPerc / 100.0)
riskMaxOk    = riskInMoney <= maxRiskMoney

// Simulación de spread
spread = 0.0
spreadOk = spread <= maxSpreadPointsIn

if triggerLong and strategy.position_size == 0 and riskMaxOk and spreadOk
    strategy.entry("Long", strategy.long, qty=qty)

if triggerShort and strategy.position_size == 0 and riskMaxOk and spreadOk
    strategy.entry("Short", strategy.short, qty=qty)

// Apertura del trade detectada
posOpened = ta.change(strategy.position_size) != 0 and strategy.position_size != 0

var box initialSLBox = na
var box initialTPBox = na

if posOpened
    entryP           := strategy.position_avg_price
    activeSL         := pendingSL
    activeTP         := pendingTP
    trailStep        := math.abs(entryP - activeSL) / 5.0
    beTriggered      := false
    slPart           := math.abs(entryP - activeSL) / trailDivisions
    tpPart           := useTP ? math.abs(activeTP - entryP) / trailDivisions : na
    pasoLaMitad      := false
    slTrail          := false
    tpChaseSlGap     := na
    if strategy.position_size > 0
        barUltimaEntradaLong := bar_index
    if strategy.position_size < 0
        barUltimaEntradaShort := bar_index
    
    // Eliminar cajas previas
    box.delete(initialSLBox)
    box.delete(initialTPBox)
    
    // Dibujar cajas iniciales de SL (rojo transparente) y TP (verde transparente)
    if strategy.position_size > 0
        initialSLBox := box.new(left=bar_index, top=entryP, right=bar_index, bottom=activeSL,
                                 bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 60),
                                 border_style=line.style_dotted)
        initialTPBox := box.new(left=bar_index, top=activeTP, right=bar_index, bottom=entryP,
                                 bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 60),
                                 border_style=line.style_dotted)
    else if strategy.position_size < 0
        initialSLBox := box.new(left=bar_index, top=activeSL, right=bar_index, bottom=entryP,
                                 bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 60),
                                 border_style=line.style_dotted)
        initialTPBox := box.new(left=bar_index, top=entryP, right=bar_index, bottom=activeTP,
                                 bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 60),
                                 border_style=line.style_dotted)

// Extender el extremo derecho de las cajas iniciales de SL y TP
if strategy.position_size != 0 and not na(initialSLBox) and not na(initialTPBox)
    box.set_right(initialSLBox, bar_index)
    box.set_right(initialTPBox, bar_index)

// ════════════════════════════════════════════════════════════════════
// 11. MOTOR DE GESTIÓN DINÁMICA: BREAK-EVEN Y TRAILING STOP
// ════════════════════════════════════════════════════════════════════

// --- CÁLCULO Y GESTIÓN DINÁMICA POR PARTES (Reglas del Proyecto) ---
if strategy.position_size > 0 and not na(slPart) and not na(tpPart)
    recorridoMax = high - entryP
    
    if not slTrail
        cercaDelTP = useTPChase and (activeTP - high <= tpChasePts)
        // Si el precio supera N - 1 partes del TP o se acerca a la distancia de persecución
        if recorridoMax >= (tpPart * (trailDivisions - 1.0)) or cercaDelTP
            tpDistTotal = tpPart * trailDivisions
            if (activeSL < entryP + (tpDistTotal / 2.0)) and not pasoLaMitad and not cercaDelTP
                activeSL := entryP + (tpDistTotal / 2.0)
                pasoLaMitad := true
            else
                slTrail := true
                tpChaseSlGap := math.max(high - activeSL, syminfo.mintick)
        else
            // Escalamiento progresivo por partes del SL (acercándose a la entrada sin rebasarla)
            for i = int(trailDivisions - 2) to 1
                if recorridoMax >= (tpPart * i)
                    nuevoSL = entryP - (slPart * (trailDivisions - i))
                    if nuevoSL > activeSL
                        activeSL := nuevoSL
                    break
    
    // Si la persecución dinámica está activa
    if slTrail and not na(tpChaseSlGap)
        trailingSL = high - tpChaseSlGap
        if trailingSL > activeSL
            activeSL := trailingSL
        // El TP solo avanza si está habilitado useTPChase y el precio se acerca a la distancia tpChasePts
        if useTPChase and (activeTP - high <= tpChasePts)
            activeTP := math.max(activeTP, high + tpChaseOffset)

else if strategy.position_size < 0 and not na(slPart) and not na(tpPart)
    recorridoMax = entryP - low
    
    if not slTrail
        cercaDelTP = useTPChase and (low - activeTP <= tpChasePts)
        // Si el precio supera N - 1 partes del TP o se acerca a la distancia de persecución
        if recorridoMax >= (tpPart * (trailDivisions - 1.0)) or cercaDelTP
            tpDistTotal = tpPart * trailDivisions
            if (activeSL > entryP - (tpDistTotal / 2.0)) and not pasoLaMitad and not cercaDelTP
                activeSL := entryP - (tpDistTotal / 2.0)
                pasoLaMitad := true
            else
                slTrail := true
                tpChaseSlGap := math.max(activeSL - low, syminfo.mintick)
        else
            // Escalamiento progresivo por partes del SL (acercándose a la entrada sin rebasarla)
            for i = int(trailDivisions - 2) to 1
                if recorridoMax >= (tpPart * i)
                    nuevoSL = entryP + (slPart * (trailDivisions - i))
                    if nuevoSL < activeSL or na(activeSL)
                        activeSL := nuevoSL
                    break
    // Si la persecución dinámica está activa
    if slTrail and not na(tpChaseSlGap)
        trailingSL = low + tpChaseSlGap
        if trailingSL < activeSL or na(activeSL)
            activeSL := trailingSL
        // El TP solo retrocede si está habilitado useTPChase y el precio se acerca a la distancia tpChasePts
        if useTPChase and (low - activeTP <= tpChasePts)
            activeTP := math.min(activeTP, low - tpChaseOffset)

// Reseteo al cerrar posición
if strategy.position_size == 0
    activeSL         := na
    activeTP         := na
    trailStep        := na
    entryP           := na
    beTriggered      := false
    tpChaseTriggered := false
    tpChaseSlGap     := na
    slPart           := na
    tpPart           := na
    pasoLaMitad      := false
    slTrail          := false

// Ejecución de salidas — se llama cada barra para que el TP chase actualice el limit dinámicamente
if strategy.position_size > 0
    strategy.exit("Exit", from_entry="Long",  stop=activeSL, limit=activeTP)
else if strategy.position_size < 0
    strategy.exit("Exit", from_entry="Short", stop=activeSL, limit=activeTP)

// ════════════════════════════════════════════════════════════════════
// 12. PLOTS DE NIVELES Y TABLA DE CONTROL
// ════════════════════════════════════════════════════════════════════
plot(strategy.position_size != 0 ? activeSL : na, "Stop Loss",   color=color.red,   style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 and useTP ? activeTP : na, "Take Profit", color=color.green, style=plot.style_linebr, linewidth=2)

// Tabla de estadísticas
var table mainTable = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)

if barstate.islast
    inTrade    = strategy.position_size != 0
    atrDisplay = str.tostring(atrVal, "#.##") + " USD"
    
    profileName = isGold ? "ORO (Auto)" : isSilver ? "PLATA (Auto)" : isBitcoin ? "BTC (Auto)" : isNasdaq ? "NASDAQ (Auto)" : "MANUAL"
    tfSugerido  = isGold ? "15min" : isSilver ? "30min" : isBitcoin ? "30min" : isNasdaq ? "5min" : "-"
    displayTF   = resolvedTF == "240" ? "4h" : resolvedTF == "60" ? "1h" : resolvedTF == "30" ? "30m" : resolvedTF == "1440" ? "1d" : resolvedTF
    imacdStatus = not useIMACD ? "DESACTIVADO" : md == 0.0 ? "RANGO" : md > 0.0 ? "ALCISTA" : "BAJISTA"
    imacdColor  = not useIMACD ? color.gray   : md == 0.0 ? color.orange : md > 0.0 ? color.green : color.red

    table.cell(mainTable, 0, 0, "Estrategia:",  text_color=color.white,  text_size=size.small)
    table.cell(mainTable, 1, 0, "HA_EMA MULTI",  text_color=color.yellow, text_size=size.small)

    table.cell(mainTable, 0, 1, "Perfil:",      text_color=color.white,  text_size=size.small)
    table.cell(mainTable, 1, 1, profileName,   text_color=color.yellow, text_size=size.small)

    table.cell(mainTable, 0, 2, "TF Sugerido:",  text_color=color.white,  text_size=size.small)
    table.cell(mainTable, 1, 2, tfSugerido,     text_color=color.yellow, text_size=size.small)

    table.cell(mainTable, 0, 3, "Estado:",       text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 3, inTrade ? "DENTRO" : "BUSCANDO",
               text_color=inTrade ? color.green : color.yellow, text_size=size.small)

    table.cell(mainTable, 0, 4, "Sesión:",       text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 4, inSession ? "ACTIVA" : "CERRADA",
               text_color=inSession ? color.green : color.gray, text_size=size.small)

    table.cell(mainTable, 0, 5, "ATR (" + timeframe.period + "):", text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 5, atrDisplay,     text_color=color.green, text_size=size.small)

    table.cell(mainTable, 0, 6, "TF EMAs:",       text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 6, displayTF,       text_color=color.yellow, text_size=size.small)

    table.cell(mainTable, 0, 7, "iMACD:",        text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 7, imacdStatus,    text_color=imacdColor, text_size=size.small)

    table.cell(mainTable, 0, 8, "Equidad:",      text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 8, "$" + str.tostring(strategy.equity, "#.##"),
               text_color=color.green, text_size=size.small)

    table.cell(mainTable, 0, 9, "Rendimiento:",  text_color=color.white, text_size=size.small)
    table.cell(mainTable, 1, 9, str.tostring(strategy.netprofit, "#.##") + " USD",
               text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)

