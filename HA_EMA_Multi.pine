    // table.cell(diagTable, 3, 10, rsiShortOK ? "OK" : "NO", bgcolor=rsiShortOK ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)
    // 
    // // Fila 11: Filtro HTF
