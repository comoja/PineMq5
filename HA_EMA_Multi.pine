    // table.cell(diagTable, 2, 8, strongBull ? "OK" : "NO", bgcolor=strongBull ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)
    // table.cell(diagTable, 3, 8, strongBear ? "OK" : "NO", bgcolor=strongBear ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)
