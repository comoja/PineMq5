//@version=6
strategy('Supertrend EMA', overlay = true, initial_capital = 500, margin_long = 1, margin_short = 1, calc_on_every_tick=true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// --- PARÁMETROS E INTERRUPTORES ---
var float riesgoPerc = 2.0
var float minRR = 1.5

// Parámetros de Indicadores
var int emaFastPeriod = 8
var int emaSlowPeriod = 21
var int atrPeriod = 18
var float factor = 3.4

// --- PARÁMETROS DE PINECONNECTOR Y WEBHOOK ---
var bool usePc = true
pcLicenseId = input.string("", "PineConnector License ID", group="PineConnector")
var string pcSymbol = ""
market_id_input = input.string("", "Market ID Opcional", group="PineConnector")
webhook_token = input.string("", "Token Secreto Webhook", group="Seguridad Webhook")
forex_account = "ggAAAAABqjwPlVclysTTnuKpbpe2knYotiFexsL22ZnxIOpcwHIEfAgOqSSRn1241XZsAChVNOd7maFcmDFjo4mo-7BN0Th72ykDyEzSd3X-KHfD9q_LpUxtxtgjhR3OFvIfIuqON7xgq"

// --- DETECCIÓN DE INSTRUMENTO Y MULTIPLICADORES (Adaptativo) ---

isSilver = str.contains(str.upper(syminfo.ticker), "XAG") or str.contains(str.upper(syminfo.ticker), "SILVER")
isGold   = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD")
isCrypto = syminfo.type == "crypto"

// Factores K (Optimizados por activo)
minRR := isCrypto ? 1.5 : isSilver ? 1.6 : isGold ? 6.3 :1.5
atrDynamicTP = isSilver ? 0.9: 1.70

atrPeriod := isCrypto ? 18 : isSilver ? 17 : isGold ? 17 : 18
factor := isCrypto ? 3.4 : isSilver ? 3.1 : isGold ? 3.9 :3.4
atrMult = isCrypto ? 2.5 : isSilver ? 2.6 : isGold ? 0.8 : 1.5
volMult = isCrypto ? 1.0 : isSilver ? 1.0 : isGold ? 1.1 : 1.1


// Restricción de Sesión NY
nyTime = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
enSesion = isCrypto or (nyTime >= 530 and nyTime <= 1600)

// --- INDICADORES BÁSICOS ---
emaFast  = ta.ema(close, emaFastPeriod)
emaSlow = ta.ema(close, emaSlowPeriod)
atrVal = ta.atr(14)
volSma = ta.sma(volume, 50)
tieneVol = not na(volume) and volume > 0
volAlto = tieneVol ? (ta.highest(volume, 3) > (volSma * volMult)) : true

// --- SUPERTREND ---
[superTrend, direction] = ta.supertrend(factor, atrPeriod)
// direction: -1 es tendencia alcista (buy), 1 es tendencia bajista (sell)
isSupertrendBullish = direction < 0
isSupertrendBearish = direction > 0

// --- SEÑALES DE ENTRADA ---
cruceAlcista = ta.crossover(emaFast, emaSlow)
cruceBajista = ta.crossunder(emaFast, emaSlow)

// Reglas de la imagen: EMA 9 cruza la 21 Y Supertrend da señal a favor
longCond = cruceAlcista and isSupertrendBullish and enSesion and volAlto
shortCond = cruceBajista and isSupertrendBearish and enSesion and volAlto

// Bloquear entradas contrarias si ya estamos en un trade
inLong = strategy.position_size > 0
inShort = strategy.position_size < 0

var float originalTp = na
var float slIni = na
var float currentRrMult = na
var bool dynamicTpActivated = false
var float atrAtActivation = na   // ATR congelado al momento de activación

if strategy.position_size == 0
    if longCond and not inShort
        slIni := close - (atrVal * atrMult)
        float tpFijo = close + (close - slIni) * minRR
        originalTp := tpFijo
        currentRrMult := minRR * atrMult 
        
        // Position Sizing basado en Riesgo Fijo
        distanciaSl = math.abs(close - slIni)
        riesgoMonetario = strategy.equity * (riesgoPerc / 100)
        qtyCorrect = distanciaSl > 0 ? riesgoMonetario / distanciaSl : 0
        string symbol_to_send = pcSymbol == "" ? syminfo.ticker : pcSymbol
        string alert_msg_buy = '{"strategy": "SupertrendEMA", "passphrase": "' + webhook_token + '", "FOREX_USERNAME": "' + forex_account + '", "ticker": "' + symbol_to_send + '", "market_id": "' + market_id_input + '", "quantity": ' + str.tostring(qtyCorrect, "#.##") + ', "entry": ' + str.tostring(close, "#.##") + ', "SL": ' + str.tostring(slIni, "#.##") + ', "TP": ' + str.tostring(tpFijo, "#.##") + ', "action": "buy"}'
        strategy.entry("Buy", strategy.long, qty = qtyCorrect, alert_message = usePc ? alert_msg_buy : "")
        
    if shortCond and not inLong
        slIni := close + (atrVal * atrMult)
        float tpFijo = close - (slIni - close) * minRR
        originalTp := tpFijo
        currentRrMult := minRR * atrMult
        
        // Position Sizing basado en Riesgo Fijo
        distanciaSl = math.abs(slIni - close)
        riesgoMonetario = strategy.equity * (riesgoPerc / 100)
        qtyCorrect = distanciaSl > 0 ? riesgoMonetario / distanciaSl : 0
        string symbol_to_send = pcSymbol == "" ? syminfo.ticker : pcSymbol
        string alert_msg_sell = '{"strategy": "SupertrendEMA", "passphrase": "' + webhook_token + '", "FOREX_USERNAME": "' + forex_account + '", "ticker": "' + symbol_to_send + '", "market_id": "' + market_id_input + '", "quantity": ' + str.tostring(qtyCorrect, "#.##") + ', "entry": ' + str.tostring(close, "#.##") + ', "SL": ' + str.tostring(slIni, "#.##") + ', "TP": ' + str.tostring(tpFijo, "#.##") + ', "action": "sell"}'
        strategy.entry("Sell", strategy.short, qty = qtyCorrect, alert_message = usePc ? alert_msg_sell : "")


// --- GESTIÓN DINÁMICA (Visual y Salidas) ---
// Regla: el TP solo se extiende hacia ganancia, NUNCA retrocede.
//   LONG : tpPrice = math.max(...)  → solo sube | usa limit
//   SHORT: tpPrice = math.min(...)  → solo baja | usa limit
// El ATR queda congelado (atrAtActivation) en el momento de activación,
// por lo que cambios de volatilidad no desplazan el TP.
var float tpPrice = na
var float slPrice = na

if strategy.position_size != 0
    float entryPrice = strategy.opentrades.entry_price(strategy.opentrades - 1)
    string symbol_to_send = pcSymbol == "" ? syminfo.ticker : pcSymbol
    
    if strategy.position_size > 0
        float metaBe = entryPrice + ((originalTp - entryPrice) * 0.51)
        
        if not dynamicTpActivated
            tpPrice := originalTp          // TP fijo mientras no se active el dinámico
            
        if not dynamicTpActivated and high >= metaBe
            dynamicTpActivated := true
            atrAtActivation    := atrVal   // Congela ATR en este momento
            
        if dynamicTpActivated
            // LONG: TP solo sube si la barra cerró alcista (close >= open)
            // Esto garantiza que la volatilidad va A FAVOR del trade.
            // Una vela bajista (ATR hacia abajo) NO mueve el TP.
            if barstate.isconfirmed and close >= open
                tpPrice := high + (atrVal * atrDynamicTP)>tpPrice? high + (atrVal * atrDynamicTP):tpPrice
            
        slPrice := superTrend
        
        string alert_msg_close_buy = '{"strategy": "SupertrendEMA", "passphrase": "' + webhook_token + '", "FOREX_USERNAME": "' + forex_account + '", "ticker": "' + symbol_to_send + '", "market_id": "' + market_id_input + '", "quantity": ' + str.tostring(math.abs(strategy.position_size), "#.##") + ', "action": "close"}'
        strategy.exit("Exit Buy", "Buy", stop=slPrice, limit=tpPrice, alert_message = usePc ? alert_msg_close_buy : "")

    if strategy.position_size < 0
        float metaBe = entryPrice - ((entryPrice - originalTp) * 0.51)
        
        if not dynamicTpActivated
            tpPrice := originalTp          // TP fijo mientras no se active el dinámico
            
        if not dynamicTpActivated and low <= metaBe
            dynamicTpActivated := true
            atrAtActivation    := atrVal   // Congela ATR en este momento
            
        if dynamicTpActivated
            // SHORT: TP solo baja si la barra cerró bajista (close <= open)
            // Esto garantiza que la volatilidad va A FAVOR del trade.
            // Una vela alcista (ATR hacia arriba) NO mueve el TP.
            if barstate.isconfirmed and close <= open
                tpPrice :=  low - (atrVal * atrDynamicTP)< tpPrice? low - (atrVal * atrDynamicTP):tpPrice            
        slPrice := superTrend
        
        string alert_msg_close_sell = '{"strategy": "SupertrendEMA", "passphrase": "' + webhook_token + '", "FOREX_USERNAME": "' + forex_account + '", "ticker": "' + symbol_to_send + '", "market_id": "' + market_id_input + '", "quantity": ' + str.tostring(math.abs(strategy.position_size), "#.##") + ', "action": "close"}'
        strategy.exit("Exit Sell", "Sell", stop=slPrice, limit=tpPrice, alert_message = usePc ? alert_msg_close_sell : "")
else
    tpPrice            := na
    slPrice            := na
    dynamicTpActivated := false
    atrAtActivation    := na


// --- GRÁFICOS ---
// EMAs
plot(emaFast, "EMA 9", color=color.yellow, linewidth=2)
plot(emaSlow, "EMA 21", color=color.blue, linewidth=2)

// Supertrend
upTrend = plot(isSupertrendBullish ? superTrend : na, "Up Trend", color=color.green, style=plot.style_linebr, linewidth=2)
downTrend = plot(isSupertrendBearish ? superTrend : na, "Down Trend", color=color.red, style=plot.style_linebr, linewidth=2)

// Cajas de Riesgo Visuales con fill()
inTrade = strategy.position_size != 0
currentEntryPrice = inTrade ? strategy.opentrades.entry_price(strategy.opentrades - 1) : na

pSl = plot(inTrade ? slPrice : na, "Stop Loss", color=color.red, linewidth=1, style=plot.style_linebr)
pTp = plot(inTrade ? tpPrice : na, "Take Profit", color=color.green, linewidth=1, style=plot.style_linebr)
pEntry = plot(currentEntryPrice, "Precio de Entrada", color=na, style=plot.style_linebr)

fill(pEntry, pSl, color=color.new(color.red, 85), title="Fondo SL")
fill(pEntry, pTp, color=color.new(color.green, 85), title="Fondo TP")

