//@version=6
strategy("HaEmaMultiV2", overlay=true, initial_capital=606,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0.04)

//+------------------------------------------------------------------+
//|                                             HaEmaMultiV2.pine    |
//|               Estrategia Unificada Heikin-Ashi + EMA             |
//|                    para ORO (XAU), PLATA (XAG),                  |
//|             BITCOIN (BTC), NAS100 y CRYPTO (CRYPTO)              |
//|          Con Autodetección de Activo, MTF y Break-Even           |
//|           (Conversión fiel al 100% de HaEmaMultiV2.mq5)          |
//+------------------------------------------------------------------+

// ════════════════════════════════════════════════════════════════════
// 1. INPUTS DE PERFIL Y AUTODETECCIÓN
// ════════════════════════════════════════════════════════════════════
gpProf       = "--- PERFIL DE CONFIGURACIÓN ---"
inpAssetProfile = input.string("Auto", "Perfil de Activo", options=["Auto", "Oro (XAUUSD)", "Plata (XAGUSD)", "Bitcoin (BTCUSD)", "Nasdaq (NAS100)", "Manual"], group=gpProf,
                 tooltip="Auto: detecta el símbolo actual para aplicar los parámetros óptimos de Oro, Plata, Bitcoin o Nasdaq. Manual: usa los parámetros de abajo.")

// ════════════════════════════════════════════════════════════════════
// 2. INPUTS DE GESTIÓN DE RIESGO
// ════════════════════════════════════════════════════════════════════
gpRisk       = "--- GESTIÓN DE RIESGO ---"
inpRiskPerc     = input.float(1.0, "Riesgo por operación (%)", minval=0.1, maxval=10.0, group=gpRisk,
                 tooltip="Porcentaje de la equidad a arriesgar basado en la distancia del SL inicial")
inpUseTP        = input.bool(true, "Usar Take Profit Fijo", group=gpRisk)
inpRrRatio      = input.float(3.0, "Relación Riesgo/Recompensa (R:R)", minval=0.5, step=0.1, group=gpRisk)
inpUseTPChase   = input.bool(false, "Usar Persecución de TP (TP Chasing)", group=gpRisk)
inpTpChasePts   = input.float(3.0, "Distancia de Persecución TP (Pts)", minval=0.1, step=1.0, group=gpRisk)
inpTpChaseOffset = input.float(3.0, "Avance del TP (Pts)", minval=0.1, step=1.0, group=gpRisk)
inpTrailDivisions = input.int(7, "Divisiones del Trailing (partes del recorrido TP→SL)", minval=1, maxval=20, group=gpRisk)
inpUseFixedLot    = input.bool(false, "¿Usar Lote Fijo? (True=Fijo, False=Riesgo %)", group=gpRisk)
inpFixedLotVal    = input.float(0.01, "Valor de Lote Fijo (Lotes MT5, ej: 0.01)", group=gpRisk)
inpMaxRiskPerc    = input.float(5.0, "Riesgo Máximo Permitido por Trade (% Balance)", minval=0.1, maxval=100.0, group=gpRisk)
inpMaxSpreadPoints = input.float(50.0, "Spread Máximo Permitido (Puntos)", minval=0.1, group=gpRisk)
inpMinStopsLevel  = input.float(0.0, "Mínimo Stop Level (Puntos)", minval=0.0, group=gpRisk)
inpSignalValidBars = input.int(5, "Velas de validez de la señal (espera de cierre de posición)", minval=1, group=gpRisk)
inpUseBE          = input.bool(true, "Usar Break-Even (BE)", group=gpRisk)

// ════════════════════════════════════════════════════════════════════
// 3. INPUTS MANUALES (Solo si Perfil = Manual)
// ════════════════════════════════════════════════════════════════════
gpParam        = "--- PARÁMETROS MANUALES (Si perfil = Manual) ---"
inpEmaTF      = input.string("Auto", "Temporalidad de EMAs", options=["Auto", "15", "30", "60", "180", "240", "1440"], group=gpParam)
inpEmaFastLen = input.int(21,  "Período EMA Rápida manual", minval=1, group=gpParam)
inpEmaSlowLen = input.int(55,  "Período EMA Lenta manual", minval=1, group=gpParam)
inpSwingPeriod = input.int(8,   "Velas Swing High/Low manual", minval=2, group=gpParam)
inpSlBufPts   = input.float(2.0, "Buffer SL manual (Ticks/Puntos)", minval=0.0, group=gpParam)
inpUseIMACD    = input.bool(false, "Usar iMACD manual", group=gpParam)
inpImacdLen    = input.int(35,     "Período iMACD manual", minval=1, group=gpParam)
inpUseEMASpread  = input.bool(true,  "Usar Abertura EMAs manual", group=gpParam)
inpEmaSpreadMult = input.float(0.4,  "Abertura Mínima EMAs manual (× ATR)", minval=0.0, step=0.1, group=gpParam)
inpUseHAStrength = input.bool(false, "Fuerza Heikin-Ashi manual", group=gpParam)
inpUseATRMin   = input.bool(false, "Filtro ATR Mínimo manual", group=gpParam)
inpAtrFilterLen = input.int(14,    "Período ATR manual", minval=1, group=gpParam)
inpAtrMinUSD   = input.float(2.0,  "ATR Mínimo USD manual", minval=0.1, step=0.1, group=gpParam)
inpUseADX       = input.bool(false, "Filtro ADX manual", group=gpParam)
inpAdxLen       = input.int(14,     "Período ADX manual", minval=1, group=gpParam)
inpAdxMin       = input.float(22.0, "ADX Mínimo manual", minval=5.0, step=1.0, group=gpParam)
inpMaxOverextensionMult = input.float(0.0, "Multiplicador de sobreextensión (0 = Desactivado)", minval=0.0, group=gpParam)
inpBodyMinMult = input.float(0.75, "Multiplicador de Cuerpo Mínimo manual (× ATR)", minval=0.0, step=0.05, group=gpParam)

// ════════════════════════════════════════════════════════════════════
// 4. CONTROL DE SESIÓN
// ════════════════════════════════════════════════════════════════════
gpSes          = "--- CONTROL DE SESIÓN ---"
inpUseSession   = input.bool(false, "Usar Sesión Horaria", group=gpSes)
inpSessionStr   = input.session("0800-1700", "Horario Operativo (UTC)", group=gpSes)
inpTimezone     = input.string("America/New_York", "Zona Horaria de la Sesión", options=["America/New_York", "America/Mexico_City", "UTC"], group=gpSes)

// ════════════════════════════════════════════════════════════════════
// 5. VARIABLES GLOBALES (Reglas del Proyecto)
// ════════════════════════════════════════════════════════════════════
var float slBufferPts = 2.0              // Buffer SL en puntos/ticks
var float rrRatio = 3.0                  // Relación R:R
var bool useIMACD = false                // ¿Usar iMACD?
var bool useEMASpread = true             // ¿Usar abertura EMAs?
var float emaSpreadMult = 0.4            // Multiplicador abertura EMAs
var bool useHAStrength = false           // ¿Usar fuerza Heikin-Ashi?
var bool useATRMin = false               // ¿Usar ATR mínimo?
var float atrMinUSD = 2.0                // ATR Mínimo en USD/puntos
var bool useADX = false                  // ¿Usar ADX?
var float adxMin = 22.0                  // ADX Mínimo
var bool useTPChase = false              // ¿Usar persecución de TP?
var bool useTP = true                    // ¿Usar TP fijo?
var float tpChasePts = 3.0               // Puntos para activar persecución TP
var float tpChaseOffset = 3.0            // Avance del TP
var int trailDivisions = 6               // Divisiones de trailing
var float maxOverextensionMult = 0.0     // Multiplicador sobreextensión
var float bodyMinMult = 0.75             // Multiplicador de cuerpo mínimo de vela
var bool useFixedLot = false             // ¿Usar lote fijo?
var float fixedLotValue = 0.01           // Valor lote fijo
var float maxRiskPerc = 5.0              // Riesgo máximo %
var float maxSpreadPoints = 50.0         // Spread máximo permitido
var float minStopsLevel = 0.0            // Nivel stop mínimo
var int signalValidBars = 5              // Validez de señal en barras
var bool useBE = true                    // ¿Usar Break-Even?
var bool useSession = false              // ¿Usar sesión horaria?
var string sessionStr = "0800-1700"      // Rango de sesión
var string timezoneVal = "America/New_York" // Zona horaria de sesión

// Parámetros de Indicadores reasignables
var string emaTF = "Auto"                // Timeframe de EMAs
var int fastLen = 21                     // Período EMA rápida
var int slowLen = 55                     // Período EMA lenta
var int swingPeriod = 8                  // Período Swing High/Low
var int imacdLen = 35                    // Período iMACD
var int imacdSignalLen = 9               // Período Señal iMACD
var int atrFilterLen = 14                // Período ATR
var int adxLen = 14                      // Período ADX
// Banderas de Huso Horario (Reglas de basicas.md)
var string targetTimezone = "America/New_York"
var string nySession = "0800-1700"       // Horario de NY adaptado a la zona seleccionada
var string cdmxSession = "0700-1600"     // Horario de CDMX adaptado a la zona seleccionada

// ════════════════════════════════════════════════════════════════════
// 6. AUTODETECCIÓN Y ASIGNACIÓN DE PARÁMETROS EFECTIVOS
// ════════════════════════════════════════════════════════════════════
tickerLower = str.lower(syminfo.ticker)
isGoldSymbol    = str.contains(tickerLower, "xau") or str.contains(tickerLower, "gold")
isSilverSymbol  = str.contains(tickerLower, "xag") or str.contains(tickerLower, "silver") or str.contains(tickerLower, "plata")
isBitcoinSymbol = str.contains(tickerLower, "btc") or str.contains(tickerLower, "bitcoin")
isNasdaqSymbol  = str.contains(tickerLower, "nas100") or str.contains(tickerLower, "nasdaq") or str.contains(tickerLower, "us100") or str.contains(tickerLower, "ustec") or str.contains(tickerLower, "nq") or str.contains(tickerLower, "tech")

isGold    = inpAssetProfile == "Oro (XAUUSD)"     or (inpAssetProfile == "Auto" and isGoldSymbol)
isSilver  = inpAssetProfile == "Plata (XAGUSD)"   or (inpAssetProfile == "Auto" and isSilverSymbol)
isBitcoin = inpAssetProfile == "Bitcoin (BTCUSD)" or (inpAssetProfile == "Auto" and isBitcoinSymbol)
isNasdaq  = inpAssetProfile == "Nasdaq (NAS100)"  or (inpAssetProfile == "Auto" and isNasdaqSymbol)
isManual  = not (isGold or isSilver or isBitcoin or isNasdaq)

// Cargar valores manuales por defecto
fastLen := inpEmaFastLen
slowLen := inpEmaSlowLen
swingPeriod := inpSwingPeriod
imacdLen := inpImacdLen
atrFilterLen := inpAtrFilterLen
adxLen := inpAdxLen
slBufferPts := inpSlBufPts
rrRatio := inpRrRatio
useIMACD := inpUseIMACD
useEMASpread := inpUseEMASpread
emaSpreadMult := inpEmaSpreadMult
useHAStrength := inpUseHAStrength
useHAStrength := inpUseHAStrength
useATRMin := inpUseATRMin
atrMinUSD := inpAtrMinUSD
useADX := inpUseADX
adxMin := inpAdxMin
useTPChase := inpUseTPChase
useTP := inpUseTP
tpChasePts := inpTpChasePts
tpChaseOffset := inpTpChaseOffset
trailDivisions := inpTrailDivisions
maxOverextensionMult := inpMaxOverextensionMult
bodyMinMult := inpBodyMinMult
useBE := inpUseBE
useFixedLot := inpUseFixedLot
fixedLotValue := inpFixedLotVal
maxRiskPerc := inpMaxRiskPerc
maxSpreadPoints := inpMaxSpreadPoints
minStopsLevel := inpMinStopsLevel
signalValidBars := inpSignalValidBars
useSession := inpUseSession
sessionStr := inpSessionStr
timezoneVal := inpTimezone

// Sobreescritura de parámetros si el perfil es automático y coincide con los símbolos
if isGold
    fastLen       := 9
    slowLen       := 20
    swingPeriod   := 7 // busca el maximo/minimo dentro de este rango de velas (pivote)
    useIMACD      := true
    imacdLen      := 20
    imacdSignalLen := 3
    atrFilterLen  := 14
    adxLen        := 14
    slBufferPts   := 0.0
    rrRatio       := 1.8
    useEMASpread  := true //abertura de emas true =separacion minima false =sin separacion
    emaSpreadMult := 0.09
    useHAStrength := false //filtro de velas ha true =sin sombra (mecha) false=velas normales con mecha
    useATRMin     := false //volatilidad del mercado medida por el ATR 
    atrMinUSD     := 0.4
    useADX        := true
    adxMin        := 18.0
    useTPChase    := true
    tpChasePts    := 12.0
    tpChaseOffset := 0.75
    useSession    := false
    sessionStr    := "0300-1700"
    timezoneVal   := "UTC"
    maxRiskPerc   := 1.0
    trailDivisions := 4
    maxOverextensionMult := 0.0
    bodyMinMult   := 0.25 // fuerza de la vela mayor o igual al 75% del ATR
    useBE := false
else if isSilver
    fastLen       := 10
    slowLen       := 21
    swingPeriod   := 5
    imacdLen      := 35
    atrFilterLen  := 14
    adxLen        := 14
    slBufferPts   := 0.5
    rrRatio       := 0.4
    useIMACD      := true
    useEMASpread  := false
    emaSpreadMult := 0.0
    useHAStrength := true
    useATRMin     := false
    atrMinUSD     := 1.0
    useADX        := false
    adxMin        := 22.0
    useTPChase    := true
    tpChasePts    := 2.0
    tpChaseOffset := 0.25
    useSession    := false
    trailDivisions := 5
    maxSpreadPoints := 100.0
    maxOverextensionMult := 0.0
    bodyMinMult   := 0.75
    useBE := false
else if isBitcoin
    fastLen       := 9
    slowLen       := 21
    swingPeriod   := 5
    imacdLen      := 35
    atrFilterLen  := 14
    adxLen        := 14
    slBufferPts   := 0.0
    rrRatio       := 1.5
    useIMACD      := true
    useEMASpread  := true
    emaSpreadMult := 0.3
    useHAStrength := true
    useATRMin     := false
    atrMinUSD     := 2.0
    useADX        := false
    adxMin        := 22.0
    useTPChase    := true
    tpChasePts    := 150.0
    tpChaseOffset := 150.0
    useSession    := false
    trailDivisions := 7
    maxSpreadPoints := 10000.0
    maxOverextensionMult := 0.0
    bodyMinMult   := 0.75
    useBE := false
else if isNasdaq
    fastLen       := 9
    slowLen       := 21
    swingPeriod   := 5
    imacdLen      := 35
    atrFilterLen  := 14
    adxLen        := 14
    slBufferPts   := 5.0
    rrRatio       := 1.5
    useIMACD      := false
    useEMASpread  := false
    emaSpreadMult := 0.0
    useHAStrength := false
    useATRMin     := false
    atrMinUSD     := 2.0
    useADX        := false
    adxMin        := 22.0
    useTPChase    := true
    tpChasePts    := 15.0
    tpChaseOffset := 15.0
    useSession    := false
    trailDivisions := 7
    maxSpreadPoints := 300.0
    maxOverextensionMult := 0.0
    bodyMinMult   := 0.75
    useBE := false

    minStopsLevel := 0.0

// Configuración de Huso Horario de Sesiones (NY y CDMX)
targetTimezone := timezoneVal
if targetTimezone == "America/New_York"
    nySession := "0800-1700"
    cdmxSession := "0700-1600"
else if targetTimezone == "America/Mexico_City"
    nySession := "0900-1800"
    cdmxSession := "0800-1700"
else // UTC
    nySession := "1300-2200"
    cdmxSession := "1200-2100"

// Validación de temporalidades recomendadas
correctTF = isGold ? "15" : isSilver ? "30" : isBitcoin ? "30" : isNasdaq ? "5" : ""
if correctTF != "" and timeframe.period != correctTF
    runtime.error("Temporalidad incorrecta para el activo actual. Por favor cambie el timeframe a: " + (isGold ? "15m" : isSilver or isBitcoin ? "30m" : "5m"))

// ════════════════════════════════════════════════════════════════════
// 7. CÁLCULO DE VELAS HEIKIN-ASHI RECURSIVAS
// ════════════════════════════════════════════════════════════════════
var float haOpen = na
haClose = (open + high + low + close) / 4
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

haGreen = haClose > haOpen
haRed   = haClose < haOpen

// Las velas Heikin-Ashi se dibujarán más abajo usando el color dinámico del iMACD

// ════════════════════════════════════════════════════════════════════
// 8. RESOLUCIÓN DE TEMPORALIDADES MTF Y MEDIAS MÓVILES
// ════════════════════════════════════════════════════════════════════
emaTF := isGold ? "Auto" : isSilver ? "15" : isBitcoin ? "15" : isNasdaq ? "Auto" : inpEmaTF
resolvedTF = emaTF == "Auto" ? timeframe.period : emaTF

needsMTF     = resolvedTF != timeframe.period
fastEmaVal   = needsMTF ? request.security(syminfo.tickerid, resolvedTF, ta.ema(close, fastLen),      lookahead=barmerge.lookahead_off) : ta.ema(close, fastLen)
slowEmaVal   = needsMTF ? request.security(syminfo.tickerid, resolvedTF, ta.ema(close, slowLen),      lookahead=barmerge.lookahead_off) : ta.ema(close, slowLen)
// Medias Móviles Rápida y Lenta

plot(fastEmaVal, "EMA Rápida (Verde)", color=color.new(color.green, 10), linewidth=2)
plot(slowEmaVal, "EMA Lenta (Naranja)", color=color.new(color.orange, 10), linewidth=2)

// ════════════════════════════════════════════════════════════════════
// 9. CÁLCULO DE INDICADORES DE FILTRO
// ════════════════════════════════════════════════════════════════════
atrVal = ta.atr(atrFilterLen)
[adxVal, diPlus, diMinus] = ta.dmi(adxLen, adxLen)
// --- FILTRO DE CONTROL HORARIO ---
inSession = not useSession or not na(time(timeframe.period, sessionStr, timezoneVal))

// --- FILTRO DE ABERTURA DE EMAs ---
distEMAs = math.abs(fastEmaVal - slowEmaVal)
aberturaOK = not useEMASpread or (distEMAs >= (atrVal * emaSpreadMult))

// --- FILTRO IMPULSE MACD ---
calcSMMA(src, len) =>
    var float smma = na
    sma_1 = ta.sma(src, len)
    smma := na(smma[1]) ? sma_1 : (smma[1] * (len - 1) + src) / len
    smma

calcZLEMA(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    d = ema1 - ema2
    ema1 + d

imacdSrc = hlc3
hi = calcSMMA(high, imacdLen)
lo = calcSMMA(low, imacdLen)
mi = calcZLEMA(imacdSrc, imacdLen)
md = mi > hi ? mi - hi : mi < lo ? mi - lo : 0.0
sb = ta.sma(md, imacdSignalLen)
sh = md - sb

imacdColor = close > mi ? close > hi ? color.lime : color.green : close < lo ? color.red : color.orange
plotcandle(haOpen, haHigh, haLow, haClose, title="Velas Heikin-Ashi (iMACD Strength)",
           color=color.new(imacdColor, 85),
           wickcolor=color.new(imacdColor, 80),
           bordercolor=na)

// plot(hi, "iMACD Canal Superior", color=color.new(color.red, 65), linewidth=1)
// plot(lo, "iMACD Canal Inferior", color=color.new(color.green, 65), linewidth=1)
// plot(mi, "iMACD Promedio ZLEMA", color=color.new(color.orange, 60), linewidth=1)

imacdLongOK  = not useIMACD or (md >= 0.0)
imacdShortOK = not useIMACD or (md <= 0.0)

// --- FILTRO DE FUERZA HEIKIN-ASHI ---
haStrengthLong  = not useHAStrength or (haLow  == haOpen)
haStrengthShort = not useHAStrength or (haHigh == haOpen)

// --- GIRO HEIKIN-ASHI RECIENTE ---
haColorChangeLong  = ta.barssince(haClose[1] < haOpen[1] and haClose > haOpen) <= 6
haColorChangeShort = ta.barssince(haClose[1] > haOpen[1] and haClose < haOpen) <= 6

// --- FILTRO ADX ---
adxOK = not useADX or (adxVal >= adxMin)

// --- FILTRO ATR MÍNIMO ---
atrOK = not useATRMin or (atrVal >= atrMinUSD)

// --- FILTRO DE SOBREEXTENSIÓN ---
sobreextendido = false
if maxOverextensionMult > 0.0
    if (close - slowEmaVal > maxOverextensionMult * atrVal) or (slowEmaVal - close > maxOverextensionMult * atrVal)
        sobreextendido := true

// --- FUERZA DE VELA (body >= bodyMinMult * ATR) ---
strongBull = (close > open) and (math.abs(close - open) >= atrVal * bodyMinMult)
strongBear = (close < open) and (math.abs(close - open) >= atrVal * bodyMinMult)

// ════════════════════════════════════════════════════════════════════
// 10. VENTANA DE CRUCES
// ════════════════════════════════════════════════════════════════════
cruzadoLong = ta.crossover(fastEmaVal, slowEmaVal)
cruzadoShort = ta.crossunder(fastEmaVal, slowEmaVal)

barrasDesdeLong = ta.barssince(cruzadoLong)
barrasDesdeShort = ta.barssince(cruzadoShort)

string bandera = "niCompraNiVenta"

mercadoLateral = useIMACD and (md == 0.0) and not strongBull and not strongBear

if not mercadoLateral
    if not na(barrasDesdeLong) and (na(barrasDesdeShort) or barrasDesdeLong < barrasDesdeShort)
        bandera := "posibleCompra"
    else if not na(barrasDesdeShort) and (na(barrasDesdeLong) or barrasDesdeShort < barrasDesdeLong)
        bandera := "posibleVenta"

pendingLongSignal  = (bandera == "posibleCompra")
pendingShortSignal = (bandera == "posibleVenta")

// ════════════════════════════════════════════════════════════════════
// 11. GATILLOS DE ENTRADA Y CÁLCULO DE LOTAJE / RIESGO
// ════════════════════════════════════════════════════════════════════
isLongAligned = pendingLongSignal and close > open and haClose > haOpen and strongBull and imacdLongOK and haStrengthLong and inSession and aberturaOK and atrOK and adxOK and not sobreextendido
isShortAligned = pendingShortSignal and close < open and haClose < haOpen and strongBear and imacdShortOK and haStrengthShort and inSession and aberturaOK and atrOK and adxOK and not sobreextendido

triggerLong  = isLongAligned
triggerShort = isShortAligned

// Funciones para buscar el primer pivote local (mínimo/máximo) hacia atrás
findSwingLow(radius) =>
    float foundLow = na
    for i = radius + 1 to 100
        isPivot = true
        for j = -radius to radius
            if low[i] > low[i + j]
                isPivot := false
                break
        if isPivot
            foundLow := low[i]
            break
    na(foundLow) ? ta.lowest(low[1], 10) : foundLow

findSwingHigh(radius) =>
    float foundHigh = na
    for i = radius + 1 to 100
        isPivot = true
        for j = -radius to radius
            if high[i] < high[i + j]
                isPivot := false
                break
        if isPivot
            foundHigh := high[i]
            break
    na(foundHigh) ? ta.highest(high[1], 10) : foundHigh

pivotRadius = math.max(2, math.floor(swingPeriod / 2))
lowestLow   = findSwingLow(pivotRadius)
highestHigh = findSwingHigh(pivotRadius)
slBuffer    = slBufferPts * syminfo.mintick

var float pendingSL = na
var float pendingTP = na

if triggerLong or triggerShort
    dir = triggerLong ? 1.0 : -1.0
    swingVal = triggerLong ? lowestLow : highestHigh
    slVal = swingVal - dir * slBuffer
    risk = math.abs(close - slVal)
    minSLDist = minStopsLevel * syminfo.mintick
    if risk < minSLDist
        risk := minSLDist
    pendingSL := close - dir * risk
    if dir * (close - pendingSL) <= 0
        pendingSL := close - dir * syminfo.mintick
    pendingTP := useTP ? (close + dir * atrVal * rrRatio) : na

// Cálculo del tamaño de la posición
contractSize = isGold ? 100.0 : isSilver ? 5000.0 : isBitcoin ? 1.0 : isNasdaq ? 1.0 : 100.0
riskAmount   = strategy.equity * (inpRiskPerc / 100.0)
riskDist     = math.abs(close - pendingSL)
qty          = 0.0

if useFixedLot
    qty := fixedLotValue * contractSize
else
    qty := riskDist > 0 ? riskAmount / (riskDist * syminfo.pointvalue) : 0.0

// Filtros de riesgo y spread
riskInMoney  = riskDist * qty * syminfo.pointvalue
maxRiskMoney = strategy.equity * (maxRiskPerc / 100.0)
riskMaxOk    = riskInMoney <= maxRiskMoney
spreadOk     = true // En Pine las órdenes simulan spread mediante comisiones

if triggerLong and strategy.position_size == 0 and riskMaxOk and spreadOk
    strategy.entry("Long", strategy.long, qty=qty)

if triggerShort and strategy.position_size == 0 and riskMaxOk and spreadOk
    strategy.entry("Short", strategy.short, qty=qty)

// ════════════════════════════════════════════════════════════════════
// 12. MOTOR DE GESTIÓN DINÁMICA DE LA POSICIÓN (Trailing & Break-Even)
// ════════════════════════════════════════════════════════════════════
posOpened = ta.change(strategy.position_size) != 0 and strategy.position_size != 0

var float activeSL = na
var float activeTP = na
var float entryP = na
var float slPart = na
var float tpPart = na
var bool pasoLaMitad = false
var bool slTrail = false
var float tpChaseSlGap = na
var bool beAplicado = false

var box initialSLBox = na
var box initialTPBox = na

if posOpened
    entryP           := strategy.position_avg_price
    activeSL         := pendingSL
    activeTP         := pendingTP
    slPart           := math.abs(entryP - activeSL) / trailDivisions
    tpPart           := useTP ? math.abs(activeTP - entryP) / trailDivisions : na
    pasoLaMitad      := false
    slTrail          := false
    tpChaseSlGap     := na
    beAplicado       := false
    
    // Eliminar cajas previas si existen
    box.delete(initialSLBox)
    box.delete(initialTPBox)
    
    // Crear nuevas cajas iniciales de SL y TP
    if strategy.position_size > 0
        initialSLBox := box.new(left=bar_index, top=entryP, right=bar_index, bottom=activeSL,
                                 bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 60),
                                 border_style=line.style_dotted)
        initialTPBox := box.new(left=bar_index, top=activeTP, right=bar_index, bottom=entryP,
                                 bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 60),
                                 border_style=line.style_dotted)
    else if strategy.position_size < 0
        initialSLBox := box.new(left=bar_index, top=activeSL, right=bar_index, bottom=entryP,
                                 bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 60),
                                 border_style=line.style_dotted)
        initialTPBox := box.new(left=bar_index, top=entryP, right=bar_index, bottom=activeTP,
                                 bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 60),
                                 border_style=line.style_dotted)

// Extender cajas iniciales a lo largo del trade
if strategy.position_size != 0 and not na(initialSLBox) and not na(initialTPBox)
    box.set_right(initialSLBox, bar_index)
    box.set_right(initialTPBox, bar_index)

// Trailing dinámico en tiempo de ejecución (cada barra)
chaseOffset = isGold ? (tpChaseOffset * atrVal) : tpChaseOffset

if strategy.position_size > 0 and not na(slPart) and not na(tpPart)
    recorridoMax = high - entryP
    
    // Break-Even a mitad del TP
    if useBE and not beAplicado and not na(activeTP) and high >= entryP + math.abs(activeTP - entryP) / 2.0 and activeSL < entryP
        activeSL := entryP
        beAplicado := true
        
    if not slTrail
        cercaDelTP = useTPChase and not na(activeTP) and (activeTP - high[1] <= tpChasePts)
        if recorridoMax >= (tpPart * (trailDivisions - 1.0)) or cercaDelTP
            tpDistTotal = tpPart * trailDivisions
            if (activeSL < entryP + (tpDistTotal / 2.0)) and not pasoLaMitad and not cercaDelTP
                activeSL := entryP + (tpDistTotal / 2.0)
                pasoLaMitad := true
            else
                slTrail := true
                tpChaseSlGap := math.max(high - activeSL, syminfo.mintick)
        else
            // Escalamiento progresivo por divisiones
            for i = int(trailDivisions - 2) to 1
                if recorridoMax >= (tpPart * i)
                    nuevoSL = entryP - (slPart * (trailDivisions - i))
                    if nuevoSL > activeSL
                        activeSL := nuevoSL
                    break
                    
    if slTrail and not na(tpChaseSlGap)
        trailingSL = high - tpChaseSlGap
        if trailingSL > activeSL
            activeSL := trailingSL
        if useTPChase and not na(activeTP) and (activeTP - high[1] <= tpChasePts)
            activeTP := math.max(activeTP, high + chaseOffset)

else if strategy.position_size < 0 and not na(slPart) and not na(tpPart)
    recorridoMax = entryP - low
    
    // Break-Even a mitad del TP
    if useBE and not beAplicado and not na(activeTP) and low <= entryP - math.abs(entryP - activeTP) / 2.0 and (activeSL > entryP or na(activeSL))
        activeSL := entryP
        beAplicado := true
        
    if not slTrail
        cercaDelTP = useTPChase and not na(activeTP) and (low[1] - activeTP <= tpChasePts)
        if recorridoMax >= (tpPart * (trailDivisions - 1.0)) or cercaDelTP
            tpDistTotal = tpPart * trailDivisions
            if (activeSL > entryP - (tpDistTotal / 2.0) or na(activeSL)) and not pasoLaMitad and not cercaDelTP
                activeSL := entryP - (tpDistTotal / 2.0)
                pasoLaMitad := true
            else
                slTrail := true
                tpChaseSlGap := math.max(activeSL - low, syminfo.mintick)
        else
            // Escalamiento progresivo por divisiones
            for i = int(trailDivisions - 2) to 1
                if recorridoMax >= (tpPart * i)
                    nuevoSL = entryP + (slPart * (trailDivisions - i))
                    if nuevoSL < activeSL or na(activeSL)
                        activeSL := nuevoSL
                    break
                    
    if slTrail and not na(tpChaseSlGap)
        trailingSL = low + tpChaseSlGap
        if trailingSL < activeSL or na(activeSL)
            activeSL := trailingSL
        if useTPChase and not na(activeTP) and (low[1] - activeTP <= tpChasePts)
            activeTP := math.min(activeTP, low - chaseOffset)

// Resetear variables al no tener posición
if strategy.position_size == 0
    activeSL := na
    activeTP := na
    entryP := na
    slPart := na
    tpPart := na
    pasoLaMitad := false
    slTrail := false
    tpChaseSlGap := na
    beAplicado := false



// Ejecución de salidas
if strategy.position_size > 0
    strategy.exit("Exit", from_entry="Long", stop=activeSL, limit=activeTP)
else if strategy.position_size < 0
    strategy.exit("Exit", from_entry="Short", stop=activeSL, limit=activeTP)

// ════════════════════════════════════════════════════════════════════
// 14. PLOTS Y TABLA DE DIAGNÓSTICO
// ════════════════════════════════════════════════════════════════════
plot(strategy.position_size != 0 ? activeSL : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 and useTP ? activeTP : na, "Take Profit", color=color.green, style=plot.style_linebr, linewidth=2)

// Crear tabla de estadísticas informativa (Dashboard)
var table mainTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.white, 15), border_width=1, border_color=color.black)

if barstate.islast
    inTrade    = strategy.position_size != 0
    atrDisplay = str.tostring(atrVal, "#.##") + " USD"
    profileName = isGold ? "ORO (Auto)" : isSilver ? "PLATA (Auto)" : isBitcoin ? "BTC (Auto)" : isNasdaq ? "NASDAQ (Auto)" : "MANUAL"
    tfSugerido  = isGold ? "15min" : isSilver ? "30min" : isBitcoin ? "30min" : isNasdaq ? "5min" : "-"
    displayTF   = resolvedTF == "240" ? "4h" : resolvedTF == "60" ? "1h" : resolvedTF == "30" ? "30m" : resolvedTF == "1440" ? "1d" : resolvedTF
    imacdStatus = not useIMACD ? "DESACTIVADO" : md == 0.0 ? "RANGO" : md > 0.0 ? "ALCISTA" : "BAJISTA"
    imacdColor  = not useIMACD ? color.gray   : md == 0.0 ? color.orange : md > 0.0 ? color.green : color.red

    table.cell(mainTable, 0, 0, "Estrategia:",  text_color=color.black,  text_size=size.small)
    table.cell(mainTable, 1, 0, "HaEmaMultiV2",  text_color=color.black, text_size=size.small)
    table.cell(mainTable, 0, 1, "Perfil:",      text_color=color.black,  text_size=size.small)
    table.cell(mainTable, 1, 1, profileName,   text_color=color.black, text_size=size.small)
    table.cell(mainTable, 0, 2, "TF Sugerido:",  text_color=color.black,  text_size=size.small)
    table.cell(mainTable, 1, 2, tfSugerido,     text_color=color.black, text_size=size.small)
    table.cell(mainTable, 0, 3, "Estado:",       text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 3, inTrade ? "DENTRO" : "BUSCANDO", text_color=inTrade ? color.green : color.orange, text_size=size.small)
    table.cell(mainTable, 0, 4, "Sesión:",       text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 4, inSession ? "ACTIVA" : "CERRADA", text_color=inSession ? color.green : color.gray, text_size=size.small)
    table.cell(mainTable, 0, 5, "ATR (" + timeframe.period + "):", text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 5, atrDisplay,     text_color=color.green, text_size=size.small)
    table.cell(mainTable, 0, 6, "TF EMAs:",       text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 6, displayTF,       text_color=color.orange, text_size=size.small)
    table.cell(mainTable, 0, 7, "iMACD:",        text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 7, imacdStatus,    text_color=imacdColor, text_size=size.small)
    table.cell(mainTable, 0, 8, "Equidad:",      text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 8, "$" + str.tostring(strategy.equity, "#.##"), text_color=color.green, text_size=size.small)
    table.cell(mainTable, 0, 9, "Net Profit:",   text_color=color.black, text_size=size.small)
    table.cell(mainTable, 1, 9, str.tostring(strategy.netprofit, "#.##") + " USD", text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)


